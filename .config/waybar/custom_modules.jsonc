  "custom/power": {
    "format": "",
    "tooltip": false,
    "menu": "on-click",
    "menu-file": "$HOME/.config/waybar/power_menu.xml",
    "menu-actions": {
      "lock": "swaylock",
      "suspend": "systemctl suspend",
      "shutdown": "poweroff",
      "reboot": "reboot",
      "hibernate": "systemctl hibernate"
    }
  }
}
