// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
	"buffer_font_weight": 500.0,
	"buffer_font_family": "FiraCode Nerd Font Mono",
	"icon_theme": "Catppuccin Mocha",
	"auto_update": false,
	"agent": {
		"profiles": {
			"write": {
				"name": "Write",
				"tools": {
					"copy_path": true,
					"create_directory": true,
					"delete_path": true,
					"diagnostics": true,
					"edit_file": true,
					"fetch": true,
					"list_directory": true,
					"project_notifications": false,
					"move_path": true,
					"now": true,
					"find_path": true,
					"read_file": true,
					"open": true,
					"grep": true,
					"terminal": true,
					"thinking": true,
					"web_search": true
				},
				"enable_all_context_servers": true,
				"context_servers": {
					"cloudflare": {
						"tools": {
							"workers_builds_list_builds": true,
							"accounts_list": true
						}
					}
				}
			}
		},
		"default_profile": "write",
		"default_model": {
			"provider": "copilot_chat",
			"model": "gpt-5-mini"
		},
		"model_parameters": [],
		"always_allow_tool_actions": true
	},
	"theme": {
		"mode": "dark",
		"light": "Catppuccin Mocha",
		"dark": "Catppuccin Mocha"
	},
	"tab_size": 4,
	"vim_mode": true,

	"ui_font_size": 15,
	"buffer_font_size": 14.0,
	// "buffer_font_family": "Zed Plex Mono",

	// "autosave": "on_focus_change",
	"format_on_save": "on",

	"terminal": {
		"shell": {
			"program": "fish"
		},
		// "blinking": "on",
		"copy_on_select": true
	},

	"telemetry": {
		"diagnostics": false,
		"metrics": false
	},

	"auto_install_extensions": {
		"basher": true,
		"biome": true,
		"catppuccin": true,
		"catppuccin-icons": true,
		"dart": true,
		"html": true,
		"ini": true,
		"kdl": true,
		"lua": true,
		"make": true,
		"proto": true,
		"svelte": true,
		"toml": true,
		"xml": true,
		"zig": true
	},

	"languages": {
		"JavaScript": {
			"formatter": { "language_server": { "name": "biome" } }
		},
		"TypeScript": {
			"formatter": { "language_server": { "name": "biome" } }
		},
		// "TSX": { "formatter": { "language_server": { "name": "biome" } } },
		"JSON": { "formatter": { "language_server": { "name": "biome" } } },
		"JSONC": { "formatter": { "language_server": { "name": "biome" } } },
		"CSS": { "formatter": { "language_server": { "name": "biome" } } }
	}
}
